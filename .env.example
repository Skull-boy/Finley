# ─────────────────────────────────────────────────────────────
#  Finley — Environment Configuration
#  COPY THIS FILE TO .env AND FILL IN YOUR VALUES
#  cp .env.example .env
#
#  NOTE: .env is gitignored — never commit real keys!
# ─────────────────────────────────────────────────────────────

# ── Telegram ──────────────────────────────────────────────────
# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# Production webhook (optional — leave empty for local polling).
# When set, the app registers this URL with Telegram and serves POST /telegram/webhook.
# Example: https://your-app.onrender.com/telegram/webhook
TELEGRAM_WEBHOOK_URL=
# Random secret sent as X-Telegram-Bot-Api-Secret-Token header — must be 32+ chars.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
# REQUIRED in production when TELEGRAM_WEBHOOK_URL is set.
TELEGRAM_WEBHOOK_SECRET=

# ── Gemini API Keys (from 3 different Google Cloud projects) ──
# Get free keys at: https://aistudio.google.com/app/apikey
# Each key = 1 separate Google account = separate daily quota.
# The gateway rotates keys automatically on rate limits — use at
# least 2 keys from different accounts for the rotation to help.
GEMINI_API_KEY_1=your_gemini_api_key_from_account_1
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
# Default maximum output tokens for normal Gemini responses. Lower it to
# reduce free-tier quota burn; raise it only if answers are being cut off.
GEMINI_MAX_OUTPUT_TOKENS=2048

# ── Gemini Models ────────────────────────────────────────────────────────────
# Model IDs are environment configuration so a Google deprecation does not
# require a code change. Both defaults are Flash models with free-tier quota.
# To use a Pro model for complex analysis, set GEMINI_SMART_MODEL to a model
# available on a billed key.
# List models available to your key:
#   python -c "from google import genai; c=genai.Client(api_key='KEY'); [print(m.name) for m in c.models.list()]"
GEMINI_FAST_MODEL=gemini-3.6-flash
GEMINI_SMART_MODEL=gemini-3.5-flash
# Embedding model for semantic memory. Must return EMBEDDING_DIMENSION values.
# gemini-embedding-001 is available on the free tier. text-embedding-004 is
# referenced by older guides but returns 404 on the live API.
EMBED_MODEL=gemini-embedding-001

# ── MongoDB ───────────────────────────────────────────────────
# Local (Docker, recommended): docker compose up -d
# The compose stack now requires auth — use the credentials below (defaults:
# MONGO_INITDB_ROOT_USERNAME=finbot, MONGO_INITDB_ROOT_PASSWORD=finbot_dev_password).
MONGODB_URI=mongodb://finbot:finbot_dev_password@localhost:27017/finbot?authSource=admin
# Cloud alternative (Atlas M0 free): mongodb+srv://user:pass@cluster.mongodb.net/finbot
MONGODB_DB_NAME=finbot

# ── Qdrant Vector Database ────────────────────────────────────
# Local (Docker, recommended): docker compose up -d
# The local stack now requires an API key (set QDRANT_API_KEY in docker-compose.yml).
# If you installed requirements-local.txt (no qdrant-client), leave QDRANT_URL
# empty to skip semantic memory and let startup preflight pass.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=dev-qdrant-key
# Cloud alternative (cloud.qdrant.io, 1GB free): set URL + API key
# Collection used for semantic memory. Use a different name per environment
# (for example finbot_memories_staging) if several deployments share a cluster.
QDRANT_COLLECTION_NAME=finbot_memories
# Vector size produced by the embedding model and stored in Qdrant.
# Must match EMBED_MODEL. gemini-embedding-001 supports 768 (the default);
# changing the model or this value requires re-embedding existing memories.
EMBEDDING_DIMENSION=768

# ── Finnhub Financial Data ────────────────────────────────────
# Get free at: https://finnhub.io (60 calls/min free, no CC)
FINNHUB_API_KEY=your_finnhub_api_key

# ── SEC EDGAR ─────────────────────────────────────────────────
# Contact email shown in the EDGAR User-Agent (SEC requires it)
SEC_CONTACT_EMAIL=your_email@example.com

# ── Google OAuth (optional, for Gmail + Calendar) ─────────────
# Setup guide in README.md — Google Cloud Console OAuth 2.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# ── App Settings ──────────────────────────────────────────────
APP_ENV=development           # development | production
APP_PORT=8000
APP_BASE_URL=http://localhost:8000

# ── Startup Preflight ────────────────────────────────────────────────────────
# Before accepting traffic, the bot verifies TOKEN_ENCRYPTION_KEY, Gemini
# reachability, the embedding model, and (when QDRANT_URL is set) the Qdrant
# collection schema. Startup fails loudly if a configured integration is broken.
# Maximum seconds for each Gemini/embedding network check. Qdrant uses its
# client's per-request timeout so schema work is never cancelled mid-flight.
PREFLIGHT_TIMEOUT_SECONDS=30
# Minimal Gemini prompt. The response only needs to be non-empty.
PREFLIGHT_PROMPT="Reply with the single word: ready"
# Output cap for the preflight Gemini call (keeps quota burn negligible).
PREFLIGHT_MAX_OUTPUT_TOKENS=10
# Text embedded during preflight to confirm the embedding model works.
PREFLIGHT_EMBEDDING_TEXT=preflight embedding check

# ── Bot Settings ──────────────────────────────────────────────
BOT_NAME=Finley
BOT_MAX_HISTORY=12            # Number of messages kept in context
BOT_MAX_MEMORY_RESULTS=5      # Number of memories injected per message
MAX_AGENTIC_ITERATIONS=3      # Max tool-calling rounds per message (quota burn cap)

# ── Security ──────────────────────────────────────────────────
# Fernet key (base64, 32 bytes) used to encrypt OAuth tokens + BYOK keys at rest.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# REQUIRED in production (app refuses to start without it).
TOKEN_ENCRYPTION_KEY=
# Previous key for rotation (optional) — decrypt tries current then previous.
TOKEN_ENCRYPTION_KEY_PREVIOUS=
# Comma-separated Telegram user IDs allowed to use the bot (empty = everyone).
ALLOWED_USER_IDS=
# Per-user message budget for the sliding-window rate limiter.
RATE_LIMIT_MESSAGES=10
RATE_LIMIT_WINDOW_SECONDS=60
# Admin stats endpoint — GET /admin/stats requires header X-Admin-Key == this value.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(24))"
# Leave empty to disable /admin/stats (returns 404).
ADMIN_API_KEY=
# ── Phase 3 — Tiered quotas (monetization-ready) ──────────────────────
# Pro users get isolated quota via BYOK or via allowlist (future Stripe).
# Comma-separated Telegram IDs that are always Pro (e.g. your own ID).
PRO_USER_IDS=
# Daily message budgets (gateway calls are the cost)
FREE_DAILY_MESSAGES=20
PRO_DAILY_MESSAGES=200
# Alert caps
FREE_MAX_ALERTS=5
PRO_MAX_ALERTS=50
# Daily briefing cap for free users (Pro users are not rate-limited here)
FREE_MAX_BRIEFINGS_PER_DAY=1

# ── Redis — optional shared cache for >1 replica (Phase 2) ────────────
# Example: redis://localhost:6379/0  or  rediss://:pass@host:6380/0
REDIS_URL=
# ── Observability — optional (Phase 2/3) ──────────────────────────────
# Sentry DSN — leave empty to disable
SENTRY_DSN=
# Log format: text (default) or json (structured, for prod)
LOG_FORMAT=text
# ── Stripe — optional (Phase 3) ─────────────────────────────────────
# Webhook secret from Stripe dashboard (whsec_...) — if set, /stripe/webhook verifies and grants Pro
STRIPE_WEBHOOK_SECRET=