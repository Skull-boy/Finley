# ─── COPY THIS FILE TO .env AND FILL IN YOUR VALUES ─────────────────────────
# cp .env.example .env

# ─── Telegram ────────────────────────────────────────────────────────────────
# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ─── Gemini API Keys (from 3 different Google Cloud projects) ─────────────────
# Get free keys at: https://aistudio.google.com/app/apikey
# Each key = 1 separate Google account = separate quota
GEMINI_API_KEY_1=your_gemini_api_key_from_account_1
GEMINI_API_KEY_2=your_gemini_api_key_from_account_2
GEMINI_API_KEY_3=your_gemini_api_key_from_account_3

# ─── MongoDB Atlas ────────────────────────────────────────────────────────────
# Get free at: https://mongodb.com/atlas (M0 cluster, no CC needed)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/finbot?retryWrites=true&w=majority
MONGODB_DB_NAME=finbot

# ─── Qdrant Vector Database ──────────────────────────────────────────────────
# Get free at: https://cloud.qdrant.io (1GB free, no CC needed)
QDRANT_URL=https://your-cluster.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key

# ─── Finnhub Financial Data ──────────────────────────────────────────────────
# Get free at: https://finnhub.io (60 calls/min free, no CC)
FINNHUB_API_KEY=your_finnhub_api_key

# ─── Google OAuth (for Gmail + Calendar integration) ─────────────────────────
# Setup guide in README.md - Google Cloud Console → OAuth 2.0 credentials
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REDIRECT_URI=https://your-app.onrender.com/auth/google/callback

# ─── App Settings ────────────────────────────────────────────────────────────
APP_ENV=development           # development | production
APP_PORT=8000
APP_BASE_URL=https://your-app.onrender.com

# ─── Bot Settings ────────────────────────────────────────────────────────────
BOT_NAME=Finley
BOT_MAX_HISTORY=20            # Number of messages to keep in context
BOT_MAX_MEMORY_RESULTS=5      # Number of memories to inject per message
